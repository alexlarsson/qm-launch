[Unit]
Description=Update QM DNS and hosts configuration
Requisite=qm2.service
PartOf=qm2.service
After=qm2.service

[Service]
Type=oneshot
# Reuse the directory without removing qm2.service's runtime files on exit.
RuntimeDirectory=qm
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=@BINDIR@/qm-launch --update-resolv-conf
