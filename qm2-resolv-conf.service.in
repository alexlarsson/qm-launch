[Unit]
Description=Update QM DNS and hosts configuration
# Allow updates while the host is still starting its basic services.
DefaultDependencies=no
Requisite=qm2.service
PartOf=qm2.service
After=qm2.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
# Reuse the directory without removing qm2.service's runtime files on exit.
RuntimeDirectory=qm
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=@BINDIR@/qmc update-resolv-conf
